{
  "name": "@quizapp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./player-token": {
      "@quizapp/source": "./src/player-token.ts",
      "types": "./dist/player-token.d.ts",
      "default": "./dist/player-token.js"
    },
    "./events-authoriser": {
      "@quizapp/source": "./src/events-authoriser.ts",
      "types": "./dist/events-authoriser.d.ts",
      "default": "./dist/events-authoriser.js"
    },
    "./repository": {
      "@quizapp/source": "./src/repository/dynamo-repository.ts",
      "types": "./dist/repository/dynamo-repository.d.ts",
      "default": "./dist/repository/dynamo-repository.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "node bundle.mjs"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1156.0",
    "@aws-sdk/client-comprehend": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/credential-provider-node": "^3.972.88",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@quizapp/contracts": "workspace:*",
    "@quizapp/domain": "workspace:*",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "aws-jwt-verify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "esbuild": "^0.28.2"
  }
}
